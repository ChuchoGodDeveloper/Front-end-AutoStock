# URL base del API de AutoStock.
# Azure Static Web Apps expone esta variable como VITE_API_URL (Settings > Configuration).
# Se acepta con o sin "/api" final; src/config/env.ts normaliza el valor.
# Ejemplos:
#   VITE_API_URL=http://localhost:5000
#   VITE_API_URL=https://autostock-backend-cyfwg9f4fbcgewfq.centralus-01.azurewebsites.net
VITE_API_URL=

# Entorno de ejecucion de la PWA: development | staging | production
VITE_APP_ENV=development
